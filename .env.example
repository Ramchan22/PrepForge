# PrepForge Environment Configuration

# Database: Default to local SQLite for instant zero-config preview.
# For Railway deployment, Railway automatically injects DATABASE_URL from the Postgres service:
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
DATABASE_URL="file:./prepforge.db"

# Caching & Background Queues (Auto-detected if provisioned on Railway)
# REDIS_URL="redis://default:password@host:port"

# Security & Authentication
JWT_SECRET="prepforge_super_secure_jwt_secret_change_in_prod_2026_xyz"
JWT_REFRESH_SECRET="prepforge_super_secure_refresh_secret_change_in_prod_2026_abc"

# Application URL
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# SMTP Configuration (Can also be managed dynamically from the Admin Panel)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@prepforge.dev"
SMTP_PASSWORD="app_password_here"
SMTP_FROM_NAME="PrepForge Coach"
SMTP_FROM_EMAIL="coach@prepforge.dev"

# Optional External AI Evaluation (If left blank, intelligent offline rule-engine is used)
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
